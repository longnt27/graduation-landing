# Vercel production: connect a PRIVATE Vercel Blob store to the project.
# New stores use project-scoped OIDC automatically. For local development,
# pull the connected project's environment or provide its Blob token.
# BLOB_READ_WRITE_TOKEN=...

# Random secret used for private GET /api/rsvp export.
ADMIN_TOKEN=replace-with-a-long-random-secret
