# RSVP delivery: add these as Vercel Project Environment Variables.
# Do not expose the bot token in client-side code or commit real values.
TELEGRAM_BOT_TOKEN=123456789:replace-with-real-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# Guestbook persistence only: connect a PRIVATE Vercel Blob store to the project.
# Production uses project-scoped credentials automatically once the store is attached.
# BLOB_READ_WRITE_TOKEN=...
