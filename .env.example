# RSVP notifications are delivered directly to Telegram.
# Never commit real credentials. Configure these in Vercel Project Settings -> Environment Variables.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# Guestbook persistence only: connect a PRIVATE Vercel Blob store to the project.
# Vercel provides runtime credentials automatically once the store is attached.
# For local development only, you may need:
# BLOB_READ_WRITE_TOKEN=...

# Application-level rate limiting for Hobby/free plans.
# Preferred: connect an Upstash Redis database and expose these env vars.
# The code also accepts KV_REST_API_URL / KV_REST_API_TOKEN from some Vercel integrations.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-rest-token
